# ==============================================================================
# BorrowBox Environment Configuration
# ==============================================================================
#
# This file provides the template for configuring BorrowBox with Supabase backend
# services (PostgreSQL, Supabase Auth, Row Level Security, Storage).
#
# Instructions:
# 1. Copy this file to '.env' (never commit '.env' containing private keys).
# 2. Fill in your project URL and public Anonymous API Key from the Supabase Dashboard.
# 3. For local or offline-only execution, the app automatically falls back to SQLite
#    and offline-first in-memory catalogs.
# ==============================================================================

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous API Key (Safe for client-side inclusion with RLS enabled)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token-here

# Optional: Remote Push Notification Gateway (e.g. Firebase Cloud Messaging / OneSignal)
PUSH_NOTIFICATION_APP_ID=
PUSH_NOTIFICATION_SERVER_KEY=
