rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true)
      );
    }

    // 1. User Profiles Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Regular users cannot grant themselves admin rights on creation
      allow create: if isOwner(userId) && 
        (!request.resource.data.keys().hasAny(['isAdmin']) || request.resource.data.isAdmin == false || isAdmin());
      
      // Prevent privilege escalation: users cannot modify 'isAdmin' unless they are already an admin
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']) || isAdmin()
      ) || (
        isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedLoans', 'rating', 'reviewCount', 'updatedAt'])
      );

      // Account deletion allowed by the owner or admin
      allow delete: if isOwner(userId) || isAdmin();

      // User's private notifications subcollection
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isAuthenticated();
      }

      // User's favorites subcollection
      match /favorites/{itemId} {
        allow read, write: if isOwner(userId);
      }

      // User's blocked peers
      match /blocked_users/{blockedUserId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Item Listings Collection
    match /items/{itemId} {
      allow read: if true; // Public marketplace browsing
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availability', 'isActive', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // 3. Borrow Requests & Transactions Collection
    match /borrow_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.borrowerId == request.auth.uid || 
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );

      // Borrower creates request; cannot borrow own item
      allow create: if isAuthenticated() && 
        request.resource.data.borrowerId == request.auth.uid && 
        request.resource.data.borrowerId != request.resource.data.ownerId;

      // Only transaction parties or admins can update transaction state
      allow update: if isAuthenticated() && (
        resource.data.borrowerId == request.auth.uid || 
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );

      allow delete: if isAdmin();

      // Transaction events (Audit trail)
      match /events/{eventId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/borrow_requests/$(requestId)).data.borrowerId == request.auth.uid || 
          get(/databases/$(database)/documents/borrow_requests/$(requestId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isAuthenticated();
        allow update, delete: if false; // Immutable audit log
      }
    }

    // 4. In-App Conversations & Messaging
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants || isAdmin()
      );
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.participants || isAdmin()
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants || isAdmin()
        );
        allow create: if isAuthenticated() && 
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow update: if isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
        allow delete: if isAdmin();
      }
    }

    // 5. Communities Collection
    match /communities/{communityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();

      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(memberId);
      }
    }

    // 6. Reviews Collection
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      // Cannot review oneself; reviewerId must match authenticated user
      allow create: if isAuthenticated() && 
        request.resource.data.reviewerId == request.auth.uid && 
        request.resource.data.reviewerId != request.resource.data.targetUserId;
      allow update, delete: if isAdmin();
    }

    // 7. Reports & Moderation Collection
    match /reports/{reportId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.reporterId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 8. Notifications Collection (Top-Level)
    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
