rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. User Profiles Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || (
        isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedLoans', 'updatedAt'])
      );
      allow delete: if false; // Accounts cannot be directly deleted via client without cascade

      // User's private notifications subcollection
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isAuthenticated();
      }

      // User's favorites subcollection
      match /favorites/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Item Listings Collection
    match /items/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availability', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // 3. Borrow Requests & Transactions Collection
    match /borrow_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.borrowerId == request.auth.uid || 
        resource.data.ownerId == request.auth.uid
      );

      // Borrower creates request; cannot borrow own item
      allow create: if isAuthenticated() && 
        request.resource.data.borrowerId == request.auth.uid && 
        request.resource.data.borrowerId != request.resource.data.ownerId;

      // Only transaction parties can update transaction state
      allow update: if isAuthenticated() && (
        resource.data.borrowerId == request.auth.uid || 
        resource.data.ownerId == request.auth.uid
      );

      allow delete: if false;

      // Transaction events (Audit trail)
      match /events/{eventId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/borrow_requests/$(requestId)).data.borrowerId == request.auth.uid || 
          get(/databases/$(database)/documents/borrow_requests/$(requestId)).data.ownerId == request.auth.uid
        );
        allow create: if isAuthenticated();
        allow update, delete: if false; // Immutable audit log
      }
    }

    // 4. Communities Collection
    match /communities/{communityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();

      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(memberId);
      }
    }

    // 5. Reviews Collection
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      // Cannot review oneself; reviewerId must match authenticated user
      allow create: if isAuthenticated() && 
        request.resource.data.reviewerId == request.auth.uid && 
        request.resource.data.reviewerId != request.resource.data.targetUserId;
      allow update, delete: if false; // Reviews are permanent once submitted
    }

    // 6. Notifications Collection (Top-Level)
    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
